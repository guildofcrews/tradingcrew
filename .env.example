# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Card recognition uses the Vercel AI Gateway (no provider API key).
# On Vercel, enable AI Gateway for this project and add a payment method.
# Deployments authenticate with the injected VERCEL_OIDC_TOKEN.
# Locally, run `vercel link` and `vercel env pull`, or set an AI Gateway key:
# AI_GATEWAY_API_KEY=""
# Optional. Must be a vision model from https://ai-gateway.vercel.sh/v1/models
# Default google/gemini-2.5-flash-lite is on the free AI Gateway credit (Google and Vertex).
# AI_GATEWAY_MODEL="google/gemini-2.5-flash-lite"

# Optional. Sorare's public GraphQL works without a key (about 20 calls a minute).
# A key from sorare.com/settings/developer raises that limit. Sent as the APIKEY header.
# SORARE_API_KEY=""

# Nightly Pokémon price refresh. Vercel Cron sends this as Authorization: Bearer.
# /api/cron/card-prices rejects every request when this is unset.
# CRON_SECRET="generate-with-openssl-rand-base64-32"
